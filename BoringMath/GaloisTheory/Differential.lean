import Mathlib.Algebra.Field.Defs
import Mathlib.RingTheory.Derivation.Basic

/-!
# Picard–Vessiot theory — ticket #554 (TREE PV.0)

Differential Galois theory: Picard–Vessiot extensions of a differential
field, next to the existing `GaloisTheory/ArtinSchreier.lean` (char-p
classical Galois theory). Mathlib at the pin has `Derivation` but no
Picard–Vessiot API (audited: PV.0 is a gap; the `trdeg = dim G∇` line is the
ticket's target).

## References
* [van der Put–Singer] M. van der Put, M. F. Singer, *Galois Theory of
  Linear Differential Equations*, Springer 2003, ch. 1.
* [Magid] A. Magid, *Lectures on Differential Galois Theory*, AMS 1994.
* mathlib pin v4.35.0-rc3: `RingTheory.Derivation`; MISSING: Picard–Vessiot.
-/

namespace BoringMath

-- Reference: [van der Put–Singer], ch. 1, §1.1 (a PV extension: a
-- differential field extension with no new constants, generated by a
-- fundamental system of solutions).
/-- A **Picard–Vessiot extension** `L/K` of the differential field `(K, dK)`:
the derivation extends compatibly and has no new constants in `L`. -/
class IsPicardVessiot (K L : Type*) [Field K] [Field L] [Algebra K L]
    (dK : Derivation K K K) (dL : Derivation K L L) : Prop where
  compat : ∀ x : K, dL (algebraMap K L x) = algebraMap K L (dK x)
  noNewConstants : ∀ y : L, dL y = 0 → y ∈ Set.range (algebraMap K L)

-- Reference: [van der Put–Singer], ch. 1, Proposition 1.3 (a PV extension is
-- generated over `K` by the entries of a fundamental solution matrix).
-- TEMPORARY SORRY with peeling plan.
-- PEELING PLAN (#554, PV.0): (i) take a fundamental system `y₁,…,yₙ` of the
-- linear ODE defining `L`; (ii) `Algebra.adjoin K {yᵢ}` is a differential
-- subfield, hence all of `L` by minimality of a PV extension; (iii) the
-- `trdeg = dim G∇` line follows by counting transcendence of the `yᵢ`
-- against the differential Galois group action.
/-- **PV fundamental theorem (generation half)**: a PV extension is generated
over `K` by finitely many solutions. -/
theorem picard_vessiot_generated_by_solutions (K L : Type*) [Field K] [Field L]
    [Algebra K L] (dK : Derivation K K K) (dL : Derivation K L L)
    [IsPicardVessiot K L dK dL] :
    ∃ (n : ℕ) (y : Fin n → L), Algebra.adjoin K (Set.range y) = ⊤ := by
  sorry

end BoringMath
