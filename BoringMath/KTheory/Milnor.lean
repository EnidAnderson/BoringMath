import Mathlib.Algebra.Field.Defs

/-!
# Milnor K-theory of fields — ticket #521 (TREE K.2)

Milnor's `K^M_*(F)`: the graded ring generated by symbols `{a} ∈ K^M₁` with
the Steinberg relation `{a, 1-a} = 0`. Mathlib at the pin has no Milnor
K-theory (audited). This module seeds the statement layer as a structure
(the typed carrier), with the Steinberg relation as the named theorem.

## References
* [Milnor] J. Milnor, *Introduction to Algebraic K-theory*, Annals of Math.
  Studies 72, Princeton 1971, §5 (Milnor K-theory, Steinberg relation).
* [Weibel] ch. III (Milnor K-theory of fields).
* mathlib pin v4.35.0-rc3: MISSING Milnor K-theory.
-/

namespace BoringMath

-- Reference: [Milnor], Annals Studies 72, §5.1 (the graded ring `K^M_*(F)`
-- with multiplication and symbols).
/-- **Milnor K-theory data** for a field `F`: a graded abelian group `K n`,
multiplication, and symbols `{a} ∈ K 1` with `{0} = 0` and
`{ab} = {a} + {b}`. -/
class MilnorK (F : Type*) [Field F] where
  K : ℕ → Type
  [instAdd : ∀ n, AddCommGroup (K n)]
  mul : ∀ (n m : ℕ), K n → K m → K (n + m)
  symbol : F → K 1
  symbol_zero : symbol 0 = 0
  symbol_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 →
    symbol (a * b) = symbol a + symbol b

-- Reference: [Milnor], Annals Studies 72, §5.1 (each `K^M_n` is an abelian
-- group; the instance is derived from the class field).
/-- Each graded piece `K n` is an abelian group. -/
instance milnorK_addCommGroup {F : Type*} [Field F] (M : MilnorK F) (n : ℕ) :
    AddCommGroup (M.K n) :=
  M.instAdd n

-- Reference: [Milnor], Annals Studies 72, §5.2 (the Steinberg relation
-- `{a, 1-a} = 0` in `K^M₂`). TEMPORARY SORRY with peeling plan.
-- PEELING PLAN (#521, TREE K.2): (i) define `K^M` concretely as the quotient of
-- the tensor algebra of `Fˣ` by `{a}⊗{1-a}`; (ii) the relation holds by
-- construction in the quotient; (iii) identify `K^M₂` with the Brauer-relevant
-- group (link to TREE K.0).
/-- **The Steinberg relation**: `{a, 1-a} = 0` in `K^M₂(F)`. -/
theorem MilnorK.steinberg (F : Type*) [Field F] (M : MilnorK F) (a : F)
    (h0 : a ≠ 0) (h1 : a ≠ 1) :
    M.mul 1 1 (M.symbol a) (M.symbol (1 - a)) = 0 := by
  sorry

end BoringMath
