import BoringMath.FormalPeriods.AxiomLint

/-!
# The axiom-ledger export: per-declaration dependency graph + grades

The export half of the choice-free lint (ticket P.0.3, leaf of P.0): for
each named declaration, the set of declarations its type and proof term
depend on (`Expr.getUsedConstants` over both), its axiom grade from
`BoringMath.lintAxioms`, and — for sorry-tainted declarations — the
dependents inside the linted scope (the conjecture graph). The command
`#lint_ledger a, b, c` renders the machine-generated LEDGER block; the
generator owns the section between the `LEDGER:BEGIN`/`LEDGER:END`
markers, never a human.

## References
* `Lean.collectAxioms` / `Lean.Expr.getUsedConstants` (Lean 4 core,
  v4.35.0-rc3), the traversal engines behind `#print axioms`.
* Program notes §§169–172 (the ledger is the machine-computed `sorryAx`
  dependency graph, 2026-10-30).
-/

namespace BoringMath

open Lean Elab Command

-- Reference: `Lean.Expr.getUsedConstants` (Lean 4 core).
/-- All constant names occurring in a declaration's type and (if any) its
value. -/
def declarationConstants (n : Name) : CoreM (Array Name) := do
  let env ← getEnv
  let ci : ConstantInfo := (Environment.find? env n).getD (panic! "unknown constant")
  -- `ConstantInfo.value?` is none for theorems at this pin; match instead.
  let v : Option Expr := match ci with
    | .defnInfo d => some d.value
    | .thmInfo t => some t.value
    | .opaqueInfo o => some o.value
    | _ => none
  let mut s : Array Name := Expr.getUsedConstants ci.type
  if let some val := v then
    s := s ++ Expr.getUsedConstants val
  return (s.toList.eraseDups).toArray

-- Reference: program notes §170 (per-declaration grade + dependency set).
/-- One row of the ledger: a declaration, its axiom grade, and the
declarations it depends on. -/
structure LedgerEntry where
  name : Name
  grade : AxiomGrade
  deps : Array Name

-- Reference: program notes §170 (the export is machine-generated).
/-- Build one ledger entry: grade from the axiom lint, deps = the used
constants that are themselves declarations. -/
def ledgerEntryOf (n : Name) : CoreM LedgerEntry := do
  let env ← getEnv
  let axioms ← Lean.collectAxioms n
  let used ← declarationConstants n
  return { name := n,
           grade := AxiomGrade.ofAxioms axioms,
           deps := used.filter env.contains }

-- Reference: program notes §170 (for each sorry'd declaration, its dependents).
/-- The members of a linted scope that depend on `entry` — the reverse
edges of the dependency graph, i.e. the conjecture graph when `entry` is
sorry-tainted. -/
def dependentsOf (entry : LedgerEntry) (scope : Array LedgerEntry) : Array Name :=
  (scope.filter (fun e => Array.contains e.deps entry.name)).map LedgerEntry.name

-- Reference: program notes §170.
/-- The grade as a string, for rendering. -/
def gradeString (g : AxiomGrade) : String :=
  match g with
  | AxiomGrade.cleanGrade => "CLEAN"
  | AxiomGrade.sorryTainted => "SORRY-TAINTED"
  | AxiomGrade.choiceTainted => "CHOICE-TAINTED"
  | AxiomGrade.banned => "BANNED"

-- Reference: program notes §170 (the LEDGER section is generator-owned).
/-- Render one ledger entry as a markdown line. -/
def LedgerEntry.render (e : LedgerEntry) : String :=
  let deps := String.intercalate ", " ((e.deps.map (fun d => s!"`{d}`")).toList)
  s!"- `{e.name}` — grade: {gradeString e.grade}; depends on: {deps}"

-- Reference: program notes §170 (dependents of sorry-tainted declarations).
/-- Render the dependents line for a sorry-tainted entry. -/
def LedgerEntry.renderDependents (e : LedgerEntry) (scope : Array LedgerEntry) : String :=
  let deps := String.intercalate ", "
    ((dependentsOf e scope).map (fun d => s!"`{d}`")).toList
  s!"- `{e.name}` — dependents in scope: {deps}"

-- Reference: program notes §170; the LEDGER markers are owned by this generator.
/-- `#lint_ledger a, b, c` prints the machine-generated LEDGER block for the
named declarations: one line per declaration (grade + dependencies), plus
the dependents line for each sorry-tainted entry. -/
elab "#lint_ledger " ns:sepBy1(ident, ",") : command => do
  let names ← ns.getElems.mapM fun n =>
    liftCoreM <| realizeGlobalConstNoOverloadWithInfo n
  let ledger ← liftCoreM (names.mapM ledgerEntryOf)
  logInfo m!"<!-- LEDGER:BEGIN (machine-generated by #lint_ledger; do not edit) -->"
  for e in ledger do
    logInfo m!"{LedgerEntry.render e}"
  for e in ledger do
    if e.grade == AxiomGrade.sorryTainted then
      logInfo m!"{LedgerEntry.renderDependents e ledger}"
  logInfo m!"<!-- LEDGER:END -->"

end BoringMath
