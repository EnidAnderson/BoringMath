import Mathlib.Data.Quot
import Mathlib.Algebra.Module.Basic
import Mathlib.Algebra.Field.Basic
import BoringMath.FormalPeriods.FreeMod
/-!
# The constructive tensor product: symbols, witness chains, quotient (part 1)

Piece 1 of `BoringMath.FormalPeriods.FreeTensor`: the raw formal sums
(`TensorSym`), the witness chains (`TensorChain`), the quotient relation
(`tensorRel`), the tensor product `FreeTensor` with its symbol class
`tensorMk`, and the induced operations (addition, scalar multiplication,
zero) with their computation lemmas.
-/
universe u v

namespace BoringMath

variable {K : Type u} [Field K] {m n : ℕ}

/-! ## The free module on abstract symbols -/

-- Reference: Hörmann, arXiv:2106.03803, proof of Key Lemma 3.2 (free module on
-- abstract symbols σ⊗ω); built by hand because `Finsupp.single` is
-- CHOICE-TAINTED at the pin (P.0.4 census).
/-- The raw terms of the free `K`-module on the symbol set
`FreeMod K m × FreeMod K n`: `nil` is the empty sum, `sym σ ω` is the abstract
symbol `σ ⊗ ω`, `add` is formal addition and `smul` formal scalar
multiplication. -/
inductive TensorSym (K : Type u) [Field K] (m n : ℕ) : Type u
  | nil : TensorSym K m n
  | sym : FreeMod K m → FreeMod K n → TensorSym K m n
  | add : TensorSym K m n → TensorSym K m n → TensorSym K m n
  | smul : K → TensorSym K m n → TensorSym K m n

-- Reference: Hörmann, arXiv:2106.03803, proof of Key Lemma 3.2 (the abstract
-- symbol σ⊗ω).
/-- The abstract symbol `σ ⊗ ω` as a raw formal sum. -/
abbrev tensorSym (σ : FreeMod K m) (ω : FreeMod K n) : TensorSym K m n :=
  TensorSym.sym σ ω

/-! ## Witness chains: equality of formal sums is data -/

-- Reference: Hörmann, arXiv:2106.03803, proof of Key Lemma 3.2 (quotient by the
-- relations, "two formal sums are equal" generated by an explicit chain);
-- Dummit–Foote, §10.4 (generators and relations).  The congruence constructors
-- are the laws of the free K-module on the symbols; the `*Sym*` constructors
-- are Hörmann's relations (i)–(iv) verbatim (with x an arbitrary formal sum),
-- plus the scalar generator `smulSymLeft`.
/-- A witness chain for the equality of two formal sums: data (not a `Prop`),
so that "two formal sums are equal" carries its proof-relevant witness.
Constructors: the equivalence/congruence laws of the free `K`-module on the
symbols (`refl`, `symm`, `trans`, `addLeft`, `addRight`, `smulC`, `nilLeft`,
`nilRight`, `addAssoc`, `addComm`, `smulNil`, `smulAdd`, `addSmul`, `oneSmul`,
`zeroSmul`, `smulSmul`) and Hörmann's relations (i)–(iv) (`zeroSymRight`,
`zeroSymLeft`, `addSymLeft`, `addSymRight`, `smulSym`) plus the scalar
relation `smulSymLeft` (in Hörmann's monoid presentation the scalar action on
the quotient is *defined* by (iv); in the free-module presentation it is the
quotient relation `c(σ⊗ω) ∼ (cσ)⊗ω`). -/
inductive TensorChain (K : Type u) [Field K] (m n : ℕ) :
    TensorSym K m n → TensorSym K m n → Type u
  | refl (x : TensorSym K m n) : TensorChain K m n x x
  | symm {x y : TensorSym K m n} (c : TensorChain K m n x y) : TensorChain K m n y x
  | trans {x y z : TensorSym K m n} (c₁ : TensorChain K m n x y)
      (c₂ : TensorChain K m n y z) : TensorChain K m n x z
  | addLeft {x y z : TensorSym K m n} (c : TensorChain K m n x y) :
      TensorChain K m n (TensorSym.add z x) (TensorSym.add z y)
  | addRight {x y z : TensorSym K m n} (c : TensorChain K m n x y) :
      TensorChain K m n (TensorSym.add x z) (TensorSym.add y z)
  | smulC {x y : TensorSym K m n} (c : K) (h : TensorChain K m n x y) :
      TensorChain K m n (TensorSym.smul c x) (TensorSym.smul c y)
  | nilLeft (x : TensorSym K m n) : TensorChain K m n (TensorSym.add TensorSym.nil x) x
  | nilRight (x : TensorSym K m n) : TensorChain K m n (TensorSym.add x TensorSym.nil) x
  | addAssoc (x y z : TensorSym K m n) :
      TensorChain K m n (TensorSym.add (TensorSym.add x y) z)
        (TensorSym.add x (TensorSym.add y z))
  | addComm (x y : TensorSym K m n) :
      TensorChain K m n (TensorSym.add x y) (TensorSym.add y x)
  | smulNil (c : K) : TensorChain K m n (TensorSym.smul c TensorSym.nil) TensorSym.nil
  | smulAdd (c : K) (x y : TensorSym K m n) :
      TensorChain K m n (TensorSym.smul c (TensorSym.add x y))
        (TensorSym.add (TensorSym.smul c x) (TensorSym.smul c y))
  | addSmul (a b : K) (x : TensorSym K m n) :
      TensorChain K m n (TensorSym.smul (a + b) x)
        (TensorSym.add (TensorSym.smul a x) (TensorSym.smul b x))
  | oneSmul (x : TensorSym K m n) : TensorChain K m n (TensorSym.smul 1 x) x
  | zeroSmul (x : TensorSym K m n) : TensorChain K m n (TensorSym.smul 0 x) TensorSym.nil
  | smulSmul (a b : K) (x : TensorSym K m n) :
      TensorChain K m n (TensorSym.smul a (TensorSym.smul b x))
        (TensorSym.smul (a * b) x)
  | zeroSymRight (x : TensorSym K m n) (σ : FreeMod K m) :
      TensorChain K m n (TensorSym.add x (TensorSym.sym σ 0)) x
  | zeroSymLeft (x : TensorSym K m n) (ω : FreeMod K n) :
      TensorChain K m n (TensorSym.add x (TensorSym.sym 0 ω)) x
  | addSymLeft (x : TensorSym K m n) (σ₁ σ₂ : FreeMod K m) (ω : FreeMod K n) :
      TensorChain K m n
        (TensorSym.add x (TensorSym.add (TensorSym.sym σ₁ ω) (TensorSym.sym σ₂ ω)))
        (TensorSym.add x (TensorSym.sym (σ₁ + σ₂) ω))
  | addSymRight (x : TensorSym K m n) (σ : FreeMod K m) (ω₁ ω₂ : FreeMod K n) :
      TensorChain K m n
        (TensorSym.add x (TensorSym.add (TensorSym.sym σ ω₁) (TensorSym.sym σ ω₂)))
        (TensorSym.add x (TensorSym.sym σ (ω₁ + ω₂)))
  | smulSym (x : TensorSym K m n) (σ : FreeMod K m) (ω : FreeMod K n) (c : K) :
      TensorChain K m n (TensorSym.add x (TensorSym.sym σ (c • ω)))
        (TensorSym.add x (TensorSym.sym (c • σ) ω))
  | smulSymLeft (x : TensorSym K m n) (σ : FreeMod K m) (ω : FreeMod K n) (c : K) :
      TensorChain K m n (TensorSym.add x (TensorSym.smul c (TensorSym.sym σ ω)))
        (TensorSym.add x (TensorSym.sym (c • σ) ω))

-- Reference: Hörmann, arXiv:2106.03803, proof of Key Lemma 3.2 (quotient by the
-- relations); Lean 4 core, Init/Prelude.lean (`Quot`).
/-- The quotient relation on formal sums: `x` and `y` are related iff a witness
chain exists.  The chain is data, so the relation is proof-relevant. -/
def tensorRel (K : Type u) [Field K] (m n : ℕ) (x y : TensorSym K m n) : Prop :=
  Nonempty (TensorChain K m n x y)

-- Reference: Hörmann, arXiv:2106.03803, proof of Key Lemma 3.2 (the tensor
-- product as a quotient); Dummit–Foote, §10.4.
/-- The constructive tensor product `FreeMod K m ⊗ FreeMod K n`: the quotient
of the free `K`-module on the abstract symbols `σ ⊗ ω` by the bilinearity
relations (i)–(iv). -/
abbrev FreeTensor (K : Type u) [Field K] (m n : ℕ) : Type u :=
  Quot (tensorRel K m n)

-- Reference: Hörmann, arXiv:2106.03803, proof of Key Lemma 3.2 (the symbol
-- σ⊗ω in the quotient).
/-- The class of the abstract symbol `σ ⊗ ω` in the tensor product. -/
abbrev tensorMk (σ : FreeMod K m) (ω : FreeMod K n) : FreeTensor K m n :=
  Quot.mk (tensorRel K m n) (tensorSym σ ω)

/-! ## Congruence of the relation and the induced operations -/

-- Reference: Dummit–Foote, §10.4 (the quotient's well-defined operations);
-- Lean 4 core, Init/Prelude.lean (`Quot.sound`).
/-- The relation is compatible with formal addition on the left. -/
theorem tensorRelAddLeft (z x y : TensorSym K m n) (h : tensorRel K m n x y) :
    tensorRel K m n (TensorSym.add z x) (TensorSym.add z y) := by
  obtain ⟨ch⟩ := h
  exact ⟨TensorChain.addLeft ch⟩

-- Reference: Dummit–Foote, §10.4; Lean 4 core, Init/Prelude.lean (`Quot.sound`).
/-- The relation is compatible with formal addition on the right. -/
theorem tensorRelAddRight (x y z : TensorSym K m n) (h : tensorRel K m n x y) :
    tensorRel K m n (TensorSym.add x z) (TensorSym.add y z) := by
  obtain ⟨ch⟩ := h
  exact ⟨TensorChain.addRight ch⟩

-- Reference: Dummit–Foote, §10.4; Lean 4 core, Init/Prelude.lean (`Quot.sound`).
/-- The relation is compatible with formal scalar multiplication. -/
theorem tensorRelSmul (c : K) (x y : TensorSym K m n) (h : tensorRel K m n x y) :
    tensorRel K m n (TensorSym.smul c x) (TensorSym.smul c y) := by
  obtain ⟨ch⟩ := h
  exact ⟨TensorChain.smulC c ch⟩

-- Reference: Dummit–Foote, §10.4 (addition on the quotient); mathlib,
-- Mathlib/Data/Quot.lean (`Quot.map₂`).
/-- Addition on `FreeTensor K m n`, descended from formal addition. -/
instance tensorAddInst : Add (FreeTensor K m n) :=
  ⟨Quot.map₂ TensorSym.add tensorRelAddLeft tensorRelAddRight⟩

-- Reference: Dummit–Foote, §10.4 (scalar multiplication on the quotient);
-- Lean 4 core, Init/Prelude.lean (`Quot.lift`).
/-- Scalar multiplication on `FreeTensor K m n` by `c`, descended from formal
scalar multiplication. -/
def tensorSmulOp (c : K) : FreeTensor K m n → FreeTensor K m n :=
  Quot.lift (fun x => Quot.mk (tensorRel K m n) (TensorSym.smul c x))
    (fun a b h => Quot.sound (tensorRelSmul c a b h))

-- Reference: Dummit–Foote, §10.4.
/-- Scalar multiplication on the tensor product. -/
instance tensorSMulInst : SMul K (FreeTensor K m n) := ⟨tensorSmulOp⟩

-- Reference: Hörmann, arXiv:2106.03803, Key Lemma 3.2, relation (i) (the empty
-- sum is the zero of the quotient).
/-- Zero on `FreeTensor K m n`: the class of the empty formal sum. -/
instance tensorZeroInst : Zero (FreeTensor K m n) :=
  ⟨Quot.mk (tensorRel K m n) TensorSym.nil⟩

-- Reference: Lean 4 core, Init/Prelude.lean (definitional unfolding of the
-- `SMul` instance); primitive definitional lemma.
/-- The `•` notation unfolds to `tensorSmulOp`. -/
theorem tensorSmulEq (c : K) (q : FreeTensor K m n) : c • q = tensorSmulOp c q := Eq.refl _

-- Reference: Lean 4 core, Init/Prelude.lean (definitional unfolding of the
-- `Zero` instance); primitive definitional lemma.
/-- The `0` of the tensor product is the class of the empty formal sum. -/
theorem tensorZeroMk : (0 : FreeTensor K m n) = Quot.mk (tensorRel K m n) TensorSym.nil :=
  Eq.refl _

-- Reference: mathlib, Mathlib/Data/Quot.lean (`Quot.map₂_mk`, proved by `rfl`);
-- primitive definitional lemma for the addition of classes.
/-- Addition of two classes is the class of the formal sum. -/
theorem tensorAddMk (x y : TensorSym K m n) :
    (Quot.mk (tensorRel K m n) x + Quot.mk (tensorRel K m n) y : FreeTensor K m n)
      = Quot.mk (tensorRel K m n) (TensorSym.add x y) :=
  Quot.map₂_mk TensorSym.add tensorRelAddLeft tensorRelAddRight x y

-- Reference: mathlib, Mathlib/Data/Quot.lean (`Quot.lift_mk`, proved by `rfl`);
-- primitive definitional lemma for the scalar action on a class.
/-- Scalar multiplication of a class is the class of the formal scalar
multiple. -/
theorem tensorSmulMk (c : K) (x : TensorSym K m n) :
    (c • Quot.mk (tensorRel K m n) x : FreeTensor K m n)
      = Quot.mk (tensorRel K m n) (TensorSym.smul c x) := by
  -- `c • q` is definitionally `tensorSmulOp c q` (`tensorSmulEq` is `Eq.refl`);
  -- transport along that equality, then `Quot.lift_mk`.
  exact Eq.subst
    (motive := fun t => t = Quot.mk (tensorRel K m n) (TensorSym.smul c x))
    (tensorSmulEq c (Quot.mk (tensorRel K m n) x)).symm (by
      unfold tensorSmulOp
      exact Quot.lift_mk (fun x => Quot.mk (tensorRel K m n) (TensorSym.smul c x))
        (fun a b h => Quot.sound (tensorRelSmul c a b h)) x)

end BoringMath
