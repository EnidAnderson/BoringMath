import BoringMath.AlgebraicGeometry.ResidueField.Tower
import Mathlib.AlgebraicGeometry.Morphisms.Preimmersion
import Mathlib.LinearAlgebra.Dimension.Finite

/-!
# The residue fields of a preimmersion

A morphism surjective on stalks induces surjections on residue fields: the
residue of the image of a germ is the image of the residue. A preimmersion is
surjective on stalks, and the source residue field is a field, so the residue
field map of a preimmersion is a bijection; the residue degree of a
preimmersion is one — an immersion does not change residue fields.

## References
* [EGA I] A. Grothendieck, J. A. Dieudonné, *Éléments de géométrie
  algébrique I: Le langage des schémas*, ch. 1 (points and residue fields).
  REVIEW(citation): pin down the section.
* [Lang] S. Lang, *Algebra*, revised 3rd ed., Springer, 2002 (the degree of
  an isomorphism of fields is one).
  REVIEW(citation): pin down the section.
-/

universe u

namespace AlgebraicGeometry

open CategoryTheory

namespace Scheme

namespace Hom

variable {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X)

-- Reference: [EGA I], ch. 1 (the residue field map sends the residue of a
-- germ to the residue of the pulled-back germ).
-- REVIEW(citation): pin down the section.
/-- The residue field map sends the residue of a germ to the residue of the
pulled-back germ. -/
theorem residueFieldMap_residue_apply (t : Y.presheaf.stalk (f x)) :
    (f.residueFieldMap x).hom ((Y.residue (f x)).hom t) =
      (X.residue x).hom ((f.stalkMap x).hom t) :=
  calc (f.residueFieldMap x).hom ((Y.residue (f x)).hom t)
      = ((f.residueFieldMap x).hom.comp (Y.residue (f x)).hom) t :=
        Eq.symm (RingHom.comp_apply (f.residueFieldMap x).hom
          (Y.residue (f x)).hom t)
    _ = (Y.residue (f x) ≫ f.residueFieldMap x).hom t := rfl
    _ = (f.stalkMap x ≫ X.residue x).hom t :=
        DFunLike.congr_fun (congrArg CommRingCat.Hom.hom
          (residue_residueFieldMap f x)) t
    _ = ((X.residue x).hom.comp (f.stalkMap x).hom) t := rfl
    _ = (X.residue x).hom ((f.stalkMap x).hom t) :=
        RingHom.comp_apply (X.residue x).hom (f.stalkMap x).hom t

-- Reference: [EGA I], ch. 1 (a morphism surjective on stalks induces
-- surjections on residue fields).
-- REVIEW(citation): pin down the section.
/-- A morphism surjective on stalks induces surjections on residue
fields. -/
theorem residueFieldMap_surjective [SurjectiveOnStalks f] (x : X) :
    Function.Surjective ⇑(f.residueFieldMap x).hom := by
  intro a
  obtain ⟨w, rfl⟩ := X.residue_surjective x a
  obtain ⟨t, rfl⟩ := f.stalkMap_surjective x w
  exact ⟨(Y.residue (f x)).hom t, residueFieldMap_residue_apply f x t⟩

-- Reference: [Lang] (the degree of an isomorphism of fields is one: the
-- target field is generated by one element over the source field).
-- REVIEW(citation): pin down the section.
/-- **The residue degree of a morphism surjective on stalks is one**: the
residue field map is a bijection (surjective since the stalk maps are, and
injective since the source is a field), so the target residue field is
generated by one element over the source, with that element nonzero. -/
theorem residueDegree_of_surjectiveOnStalks [SurjectiveOnStalks f] (x : X) :
    f.residueDegree x = 1 := by
  have hsurj : Function.Surjective ⇑(f.residueFieldMap x).hom :=
    residueFieldMap_surjective f x
  refine @finrank_eq_one (↑(Y.residueField (f x))) (↑(X.residueField x))
    _ _ _ _ _ _ (1 : ↑(X.residueField x)) one_ne_zero ?_
  intro w
  obtain ⟨c, hc⟩ := hsurj w
  exact ⟨c, Eq.trans
    (Eq.trans (Algebra.smul_def c 1)
      (mul_one ((f.residueFieldMap x).hom c))) hc⟩

-- Reference: [EGA I], ch. 1 (an immersion does not change residue fields).
-- REVIEW(citation): pin down the section.
/-- **An immersion does not change residue fields**: the residue degree of
a preimmersion at every point is one. -/
theorem residueDegree_of_isPreimmersion [IsPreimmersion f] (x : X) :
    f.residueDegree x = 1 :=
  residueDegree_of_surjectiveOnStalks f x

end Hom

end Scheme

end AlgebraicGeometry
