import BoringMath.AlgebraicGeometry.Motives.A1
import BoringMath.AlgebraicGeometry.Sites.Nisnevich
import Mathlib.CategoryTheory.Sites.Sheaf
import Mathlib.CategoryTheory.Sites.InducedTopology
import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
import Mathlib.CategoryTheory.Localization.CalculusOfFractions

/-!
# Effective Voevodsky motives `DM^eff` — the A¹-localization station (C.4)

The category the C-line aims at (work order #117): the **Nisnevich sheaves
with transfers** over `S` — the presheaves with transfers whose underlying
presheaf on the smooth site `Sm/S` is a Nisnevich sheaf (MVW's criterion) —
localized at the class generated by the **A¹-projections** `M(X ×_S 𝔸¹) →
M(X)`.

Statement layer (Tier 1, #117): the sheaf category, the A¹-projection
morphism of representables, and the localization datum are stated exactly;
the A¹-projection is invertible in the localized category (proved, from the
Gabriel–Zisman construction's `wIso`); the localization sequence and the
cancellation property are sorried with peeling plans. The 1-categorical
Gabriel–Zisman form is what is landed now; the triangulated Verdier-quotient
form (`D(Shv_Nis(PWT))` modulo the thick subcategory generated by the cones of
the A¹-projections, per Voevodsky's Three Lectures, Def. 2.4) is the named
supersession, riding T.1 (#23) and the B-line's Nisnevich Mayer–Vietoris
(#26) — the ∞-categorical upgrade is likewise a named supersession.

## References
* V. Voevodsky, *Three Lectures on Motivic Cohomology*, MPI Bonn preprint
  (2000), Definition 2.4: `DM^eff(k)` is the localization of `D(NST(k))` by
  the localizing subcategory generated by the cones of `Z_tr(A¹) ⊗ K → K`.
  REVIEW(citation): pin the preprint number.
* C. Mazza, V. Voevodsky, C. Weibel, *Lecture Notes on Motivic Cohomology*,
  Clay Mathematics Monographs 2, 2006, Lectures 11–14 (Nisnevich sheaves with
  transfers; the triangulated category of motives `DM`).
  REVIEW(citation): pin the exact lectures/sections in review.
* V. Voevodsky, *A¹-homotopy theory*, Proc. Sympos. Pure Math. 67 (1998) /
  DMV Seminar 48, Birkhäuser, 2000.
  REVIEW(citation): pin the section in review.
-/

universe u

namespace AlgebraicGeometry

open CategoryTheory Limits

variable (S : Scheme.{u})

-- Reference: MVW (2006), Lecture 1, p. 3 (the forgetful functor `Sm/S ⥤ Sch`).
/-- The forgetful functor from the smooth site `Sm/S` to schemes. -/
def forgetSmoothOver : SmoothSchemeOver S ⥤ Scheme.{u} where
  obj X := X.carrier
  map f := f.1
  map_id _ := rfl
  map_comp _ _ := rfl

-- Reference: Voevodsky (2010), *Homotopy theory of simplicial sheaves in
-- completely decomposable topologies*, §2 (the Nisnevich topology);
-- landed as `nisnevichTopology` (B.2, #9).
-- REVIEW(citation): the small Nisnevich site over `S` is the B-line's Tier-2
-- target; here the topology on `Sm/S` is pulled back from the big site along
-- the forgetful functor.
/-- The **Nisnevich topology on the smooth site** `Sm/S`, pulled back from the
big Nisnevich topology on `Scheme` along the forgetful functor (statement
layer; the intrinsic small site over `S` is the B-line's Tier-2 target). -/
noncomputable def nisnevichTopologySmOver (S : Scheme.{u}) :
    GrothendieckTopology (SmoothSchemeOver S) :=
  Functor.restrictedTopology (forgetSmoothOver S) nisnevichTopology

variable {S : Scheme.{u}}

-- Reference: MVW (2006), Lectures 11–13 (a presheaf with transfers is a
-- Nisnevich sheaf iff its underlying presheaf on `Sm/S` is a Nisnevich sheaf).
-- REVIEW(citation): pin the exact lecture/lemma in review.
/-- A presheaf with transfers is a **Nisnevich sheaf with transfers** iff its
underlying presheaf on `Sm/S` (restriction along the graph functor) is a
sheaf for the Nisnevich topology. -/
def IsNisnevichSheafWithTransfers (F : PresheafWithTransfer S) : Prop :=
  Presheaf.IsSheaf (nisnevichTopologySmOver S) ((graphFunctor (S := S)).op ⋙ F.toFunctor)

-- Reference: MVW (2006), Lectures 11–13 (the category `Shv_Nis(PST)`).
-- REVIEW(citation): pin the exact lecture in review.
/-- The **category of Nisnevich sheaves with transfers** over `S`: the full
subcategory of presheaves on `SmCor(S)` cut out by the Nisnevich sheaf
condition on `Sm/S`. -/
abbrev NisnevichSheafWithTransfers (S : Scheme.{u}) :=
  ObjectProperty.FullSubcategory (fun F : (SmCor S)ᵒᵖ ⥤ AddCommGrpCat.{u} =>
    Presheaf.IsSheaf (nisnevichTopologySmOver S) ((graphFunctor (S := S)).op ⋙ F))

-- Reference: MVW (2006), the projection `X × A¹ → X`.
-- REVIEW(citation): pin the exact construction in review.
/-- The **projection morphism** `X ×_S 𝔸¹ → X` in `SmCor(S)`, as the graph
correspondence of the first projection of the fiber product. `noncomputable`:
the graph correspondence is choice-backed. -/
noncomputable def smCorAffineLineProj (X : SmoothSchemeOver S) [IsNoetherian S] :
    smCorAffineLineProduct X ⟶ ⟨X⟩ := by
  have hN : IsNoetherian (SmCorObj.carrier (smCorAffineLineProduct X)) :=
    isNoetherian_pullback_affineLineProj X
  exact graphFiniteCorrespondence _ _ (pullback.fst X.proj (affineLineProj S)) rfl
    (quasiCompact_graph_of_isSeparated _ _ _ rfl X.separated)

-- Reference: MVW (2006), Lectures 11–14 (the A¹-projection `Z_tr(X × A¹) →
-- `Z_tr(X)` of representable sheaves with transfers).
-- REVIEW(citation): pin the exact lecture in review.
/-- The **A¹-projection morphism of representables**: `ℤ_tr(X ×_S 𝔸¹) ⟶ ℤ_tr(X)`,
postcomposition with the projection correspondence. `noncomputable`: choice-backed. -/
noncomputable def a1Projection (X : SmCor S) [IsNoetherian S] [IsNoetherian X.over.carrier] :
    (PresheafWithTransfer.zTr (smCorAffineLineProduct X.over)).toFunctor ⟶
      (PresheafWithTransfer.zTr X).toFunctor :=
  preadditiveYoneda.map (smCorAffineLineProj X.over)

-- Reference: Voevodsky, *Three Lectures on Motivic Cohomology*, Def. 2.4;
-- #117 scope contract (statement-layer: hypotheses as structure fields, no
-- `axiom` decls).
-- REVIEW(citation): pin the preprint number.
/-- A **DM^eff localization datum** over `S`: the sheafification into
Nisnevich sheaves with transfers, a morphism class `W` containing the
sheafified A¹-projections, and the Gabriel–Zisman localization. -/
structure EffectiveMotiveCategory (S : Scheme.{u}) where
  /-- sheafification into the Nisnevich sheaves with transfers -/
  sheafify : ((SmCor S)ᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ NisnevichSheafWithTransfers S
  /-- the A¹-localization class of morphisms -/
  W : MorphismProperty (NisnevichSheafWithTransfers S)
  /-- `W` contains the sheafified A¹-projections -/
  a1Projections : ∀ (X : SmCor S) [IsNoetherian S] [IsNoetherian X.over.carrier],
    W (sheafify.map (a1Projection X))

-- Reference: Voevodsky, *Three Lectures on Motivic Cohomology*, Def. 2.4
-- (`DM^eff` as the localization at the A¹-class); Gabriel–Zisman,
-- *Calculus of fractions and homotopy theory*, 1967, §1.
-- REVIEW(citation): pin the preprint/section.
/-- **`DM^eff(S)` (Nisnevich, effective)**: the Gabriel–Zisman localization of
the Nisnevich sheaves with transfers at the A¹-class `W`. -/
abbrev dmEff (D : EffectiveMotiveCategory S) : Type (u+1) :=
  D.W.Localization

-- Reference: Voevodsky, *Three Lectures on Motivic Cohomology*, Def. 2.4
-- (the A¹-projections are inverted in `DM^eff`); Gabriel–Zisman 1967 (the
-- construction inverts exactly `W`).
/-- **First law: the A¹-projection is invertible in `DM^eff(S)`** — the
Gabriel–Zisman construction inverts every morphism of `W`, in particular the
sheafified A¹-projection. -/
theorem a1Projection_isIso_dmEff (D : EffectiveMotiveCategory S) (X : SmCor S)
    [IsNoetherian S] [IsNoetherian X.over.carrier] :
    IsIso (D.W.Q.map (D.sheafify.map (a1Projection X))) :=
  (Localization.Construction.wIso (D.sheafify.map (a1Projection X))
    (D.a1Projections X)).isIso_hom

-- Reference: Voevodsky, *Three Lectures on Motivic Cohomology*, Def. 2.4
-- (the universal property of the localization); Gabriel–Zisman 1967, §1
-- (the calculus-of-fractions localization has the universal property).
-- REVIEW(citation): pin the sections.
/-- **Universal property of `DM^eff(S)`**: any functor out of the Nisnevich
sheaves with transfers that inverts the A¹-class `W` factors through the
localization functor `W.Q`. `noncomputable`: mathlib's `Localization.lift` is
choice-backed at the pin, flagged per STYLE §2.3. -/
noncomputable def dmEff_lift (D : EffectiveMotiveCategory S) {E : Type (u + 1)}
    [Category.{u} E] (G : NisnevichSheafWithTransfers S ⥤ E) (hG : D.W.IsInvertedBy G) :
    dmEff D ⥤ E :=
  Localization.lift G hG D.W.Q

-- Reference: Voevodsky, *Three Lectures on Motivic Cohomology*, Def. 2.4;
-- MVW (2006), Lectures 11–14 (the localization sequence
-- `M(X × A¹) → M(X) → C → M(X × A¹)[1]` and the cancellation theorem in `DM`).
-- REVIEW(citation): pin the exact lecture/theorem in review.
-- NAMED NEXT PEELS (statement layer, #117): the triangulated Verdier form of
-- the localization sequence (rides T.1/#23 + B.4/#26), the tensor structure
-- via Day convolution on PWT, the Tate object `ℚ(1)` as the reduced motive of
-- `(P¹, ∞)`, and the cancellation theorem `Hom(M(X), M(Y)(n))` — each to be
-- stated as its own named module when the substrate lands.

end AlgebraicGeometry
