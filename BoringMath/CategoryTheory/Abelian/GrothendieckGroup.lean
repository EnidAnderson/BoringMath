import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Homology.ShortComplex.ShortExact
import Mathlib.CategoryTheory.Abelian.Basic
import Mathlib.CategoryTheory.IsomorphismClasses
import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# The Grothendieck group `K₀` of an abelian category

For an abelian category `A`, the Grothendieck group `K0 A` is the quotient of
the free abelian group on the isomorphism classes of objects of `A` by the
subgroup generated by the relations `[X₂] - [X₁] - [X₃]` for every short exact
sequence `0 → X₁ → X₂ → X₃ → 0` (equivalently `[X₂] = [X₁] + [X₃]`).

The module provides: the bundled short exact sequences (`K0.ShortExactSequence`),
the relation element and subgroup (`K0.sesRel`, `K0.sesRelations`), the group
`K0 A` itself, the class map `K0.of` with its additivity on short exact
sequences (`K0.of_shortExact`), the map induced by an exact functor
(`K0.map`), and the universal property (`K0.liftEquiv`).

Mathlib at the pin provides the Grothendieck group of a commutative monoid
(`Algebra.GrothendieckGroup`); its docstring flags the abelian-category variant
as a TODO. No `K₀` of an abelian category exists in mathlib at the pin
(searched `GrothendieckGroup`, `K0`, `KTheory` in the checkout).

## References
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, GSM 145,
  Amer. Math. Soc., 2013, Chapter II ("The Grothendieck group K₀"): K₀ of an
  abelian category via exact-sequence relations, functoriality, and the
  universal property. Verified online (sites.math.rutgers.edu/~weibel/Kbook,
  Kbook.II.pdf).
  REVIEW(citation): pin the exact section number within Ch. II (routed to
  W5, issue #13).
* SGA 6, Exposé I (origins of the Grothendieck group).
  REVIEW(citation): pin the exposé in review (routed to W5, issue #13).
-/

universe u v

namespace CategoryTheory

namespace K0

variable {A : Type u} [Category.{v} A] [Abelian A]

-- Reference: C. A. Weibel, *The K-book*, Ch. II (short exact sequences in an
-- abelian category; the witnesses are bundled explicitly, not existentially).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- A **short exact sequence** `0 → X₁ → X₂ → X₃ → 0` in an abelian category,
bundled as explicit data: a short complex `X₁ ⟶ X₂ ⟶ X₃` that is exact, with
first map a monomorphism and second map an epimorphism. -/
structure ShortExactSequence (A : Type u) [Category.{v} A] [Abelian A] where
  /-- the underlying short complex -/
  sc : ShortComplex A
  /-- the short complex is short exact -/
  shortExact : sc.ShortExact

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the relation [X₂] = [X₁] + [X₃]).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The relation element `[X₂] - [X₁] - [X₃]` of the free abelian group on
isomorphism classes attached to a short exact sequence `0 → X₁ → X₂ → X₃ → 0`. -/
def sesRel (ses : ShortExactSequence A) :
    FreeAbelianGroup (Quotient (isIsomorphicSetoid A)) :=
  FreeAbelianGroup.of (⟦ses.sc.X₂⟧ : Quotient (isIsomorphicSetoid A))
    - FreeAbelianGroup.of (⟦ses.sc.X₁⟧ : Quotient (isIsomorphicSetoid A))
    - FreeAbelianGroup.of (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the generating set of relations).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The subgroup of **short exact sequence relations** in the free abelian group
on the isomorphism classes of `A`: the closure of the elements
`[X₂] - [X₁] - [X₃]` over all short exact sequences. -/
def sesRelations :
    AddSubgroup (FreeAbelianGroup (Quotient (isIsomorphicSetoid A))) :=
  AddSubgroup.closure (Set.range sesRel)

end K0

-- Reference: C. A. Weibel, *The K-book*, Ch. II (K₀ of an abelian category).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The **Grothendieck group `K₀` of an abelian category `A`**: the quotient of
the free abelian group on the isomorphism classes of objects of `A` by the
short-exact-sequence relations `[X₂] - [X₁] - [X₃]`. -/
abbrev K0 (A : Type u) [Category.{v} A] [Abelian A] : Type u :=
  FreeAbelianGroup (Quotient (isIsomorphicSetoid A)) ⧸ K0.sesRelations (A := A)

namespace K0

variable {A : Type u} [Category.{v} A] [Abelian A]

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the class map [X]).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The **class map** `of : A → K0 A`, sending each object to its class in the
Grothendieck group. -/
def of (X : A) : K0 A :=
  QuotientAddGroup.mk' (sesRelations (A := A))
    (FreeAbelianGroup.of (⟦X⟧ : Quotient (isIsomorphicSetoid A)))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the class of an object depends
-- only on its isomorphism class).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The class map is constant on isomorphism classes. -/
theorem of_eq_of_iso {X Y : A} (h : IsIsomorphic X Y) : of X = of Y :=
  congrArg
    (fun q => QuotientAddGroup.mk' (sesRelations (A := A)) (FreeAbelianGroup.of q))
    (Quotient.sound (s := isIsomorphicSetoid A) (a := X) (b := Y) h)

variable {G : Type*} [AddCommGroup G]

-- Reference: standard group identity, used to clear the defining relation.
/-- Group identity: `a + -(a - b - c) = b + c`. -/
theorem add_neg_sub_sub_eq (a b c : G) : a + -(a - b - c) = b + c :=
  Eq.trans (sub_eq_add_neg a (a - b - c)).symm
    (Eq.trans (congrArg (fun t => a - t) (sub_sub a b c)) (sub_sub_cancel a (b + c)))

variable {A : Type u} [Category.{v} A] [Abelian A]

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the defining relation
-- [X₂] = [X₁] + [X₃] for short exact sequences).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- **Additivity on short exact sequences**: for every short exact sequence
`0 → X₁ → X₂ → X₃ → 0` in `A`, the class of the middle object equals the sum of
the classes of the two ends: `[X₂] = [X₁] + [X₃]` in `K0 A`. -/
theorem of_shortExact (ses : ShortExactSequence A) :
    of ses.sc.X₂ = of ses.sc.X₁ + of ses.sc.X₃ := by
  have hmem : -(sesRel ses) ∈ sesRelations (A := A) :=
    AddSubgroup.neg_mem _ (AddSubgroup.subset_closure (Set.mem_range_self ses))
  have key : FreeAbelianGroup.of (⟦ses.sc.X₂⟧ : Quotient (isIsomorphicSetoid A))
        + -(sesRel ses)
      = FreeAbelianGroup.of (⟦ses.sc.X₁⟧ : Quotient (isIsomorphicSetoid A))
        + FreeAbelianGroup.of (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A)) :=
    add_neg_sub_sub_eq
      (FreeAbelianGroup.of (⟦ses.sc.X₂⟧ : Quotient (isIsomorphicSetoid A)))
      (FreeAbelianGroup.of (⟦ses.sc.X₁⟧ : Quotient (isIsomorphicSetoid A)))
      (FreeAbelianGroup.of (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A)))
  have hmk : (QuotientAddGroup.mk' (sesRelations (A := A)))
        (FreeAbelianGroup.of (⟦ses.sc.X₂⟧ : Quotient (isIsomorphicSetoid A)))
      = (QuotientAddGroup.mk' (sesRelations (A := A)))
        (FreeAbelianGroup.of (⟦ses.sc.X₁⟧ : Quotient (isIsomorphicSetoid A))
          + FreeAbelianGroup.of (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A))) :=
    (QuotientAddGroup.mk'_eq_mk' (sesRelations (A := A)) (x := _) (y := _)).mpr
      ⟨-(sesRel ses), hmem, key⟩
  exact Eq.trans hmk ((QuotientAddGroup.mk' (sesRelations (A := A))).map_add _ _)

section Functoriality

variable {B : Type u} [Category.{v} B] [Abelian B]

omit [Abelian A] [Abelian B] in
-- Reference: C. A. Weibel, *The K-book*, Ch. II (functoriality of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The map on isomorphism classes induced by a functor (functors preserve
isomorphisms). -/
def isoClassesMap (F : A ⥤ B) :
    Quotient (isIsomorphicSetoid A) → Quotient (isIsomorphicSetoid B) :=
  Quotient.lift (fun X => (⟦F.obj X⟧ : Quotient (isIsomorphicSetoid B)))
    (fun X Y h => Quotient.sound (s := isIsomorphicSetoid B) (a := F.obj X) (b := F.obj Y)
      (Nonempty.map F.mapIso h))

omit [Abelian A] [Abelian B] in
-- Reference: C. A. Weibel, *The K-book*, Ch. II (functoriality of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The value of `isoClassesMap` on the class of an object. -/
theorem isoClassesMap_mk (F : A ⥤ B) (X : A) :
    isoClassesMap F (⟦X⟧ : Quotient (isIsomorphicSetoid A))
      = (⟦F.obj X⟧ : Quotient (isIsomorphicSetoid B)) :=
  Quotient.lift_mk (s := isIsomorphicSetoid A)
    (fun Y => (⟦F.obj Y⟧ : Quotient (isIsomorphicSetoid B)))
    (fun X Y h => Quotient.sound (s := isIsomorphicSetoid B) (a := F.obj X) (b := F.obj Y)
      (Nonempty.map F.mapIso h))
    X

omit [Abelian A] [Abelian B] in
-- Reference: C. A. Weibel, *The K-book*, Ch. II (functoriality of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The homomorphism of free abelian groups on isomorphism classes induced by
`F`. -/
def freeAbelianMap (F : A ⥤ B) :
    FreeAbelianGroup (Quotient (isIsomorphicSetoid A)) →+
      FreeAbelianGroup (Quotient (isIsomorphicSetoid B)) :=
  FreeAbelianGroup.map (isoClassesMap F)

omit [Abelian A] in
-- Reference: C. A. Weibel, *The K-book*, Ch. II (functoriality of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The composite of `freeAbelianMap F` with the quotient map into `K0 B`. -/
def toK0 (F : A ⥤ B) :
    FreeAbelianGroup (Quotient (isIsomorphicSetoid A)) →+ K0 B :=
  (QuotientAddGroup.mk' (sesRelations (A := B))).comp (freeAbelianMap F)

omit [Abelian A] in
-- Reference: C. A. Weibel, *The K-book*, Ch. II (functoriality of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The composite sends the generator of a class to the class of the image. -/
theorem toK0_of (F : A ⥤ B) (X : A) :
    toK0 F (FreeAbelianGroup.of (⟦X⟧ : Quotient (isIsomorphicSetoid A))) = of (F.obj X) :=
  Eq.trans (AddMonoidHom.comp_apply _ _ _)
    (congrArg (QuotientAddGroup.mk' (sesRelations (A := B)))
      (Eq.trans (FreeAbelianGroup.map_of_apply (f := isoClassesMap F)
          (⟦X⟧ : Quotient (isIsomorphicSetoid A)))
        (congrArg FreeAbelianGroup.of (isoClassesMap_mk F X))))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (exact functors preserve the
-- short-exact-sequence relations).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The composite `toK0 F` kills every short exact sequence relation. -/
theorem toK0_sesRel (F : A ⥤ B) [F.PreservesZeroMorphisms]
    (hF : ∀ S : ShortComplex A, S.ShortExact → (S.map F).ShortExact)
    (ses : ShortExactSequence A) : toK0 F (sesRel ses) = 0 := by
  have hzero : of (F.obj ses.sc.X₂) - of (F.obj ses.sc.X₁) - of (F.obj ses.sc.X₃) = 0 := by
    have hse := of_shortExact (A := B) ⟨ses.sc.map F, hF ses.sc ses.shortExact⟩
    exact Eq.trans
      (congrArg (fun t => t - of (F.obj ses.sc.X₁) - of (F.obj ses.sc.X₃)) hse)
      (Eq.trans (congrArg (fun t => t - of (F.obj ses.sc.X₃)) (add_sub_cancel_left _ _))
        (sub_self _))
  exact Eq.trans (map_sub (toK0 F) _ _)
    (Eq.trans
      (congrArg (fun t => t - toK0 F (FreeAbelianGroup.of (⟦ses.sc.X₃⟧ :
          Quotient (isIsomorphicSetoid A)))) (map_sub (toK0 F) _ _))
      (Eq.trans
        (congrArg (fun t => (t - toK0 F (FreeAbelianGroup.of (⟦ses.sc.X₁⟧ :
            Quotient (isIsomorphicSetoid A)))) - toK0 F (FreeAbelianGroup.of (⟦ses.sc.X₃⟧ :
            Quotient (isIsomorphicSetoid A)))) (toK0_of F ses.sc.X₂))
        (Eq.trans
          (congrArg (fun t => (of (F.obj ses.sc.X₂) - t) - toK0 F (FreeAbelianGroup.of
              (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A)))) (toK0_of F ses.sc.X₁))
          (Eq.trans
            (congrArg (fun t => (of (F.obj ses.sc.X₂) - of (F.obj ses.sc.X₁)) - t)
              (toK0_of F ses.sc.X₃))
            hzero))))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (an exact functor induces a
-- homomorphism on K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The **induced map** `map : K0 A →+ K0 B` of a functor `F : A ⥤ B` that
preserves zero morphisms and sends short exact sequences to short exact
sequences (an exact functor). -/
def map (F : A ⥤ B) [F.PreservesZeroMorphisms]
    (hF : ∀ S : ShortComplex A, S.ShortExact → (S.map F).ShortExact) : K0 A →+ K0 B :=
  QuotientAddGroup.lift (sesRelations (A := A)) (toK0 F)
    ((AddSubgroup.closure_le _).mpr (fun x hx => by
      obtain ⟨ses, rfl⟩ := hx
      exact AddMonoidHom.mem_ker.mpr (toK0_sesRel F hF ses)))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (compatibility of the induced
-- map with the class maps).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The induced map is compatible with the class maps:
`map F hF (of X) = of (F.obj X)`. -/
theorem map_of (F : A ⥤ B) [F.PreservesZeroMorphisms]
    (hF : ∀ S : ShortComplex A, S.ShortExact → (S.map F).ShortExact) (X : A) :
    map F hF (of X) = of (F.obj X) :=
  Eq.trans
    (congrArg (map F hF) (QuotientAddGroup.mk'_apply (sesRelations (A := A)) _))
    (Eq.trans (QuotientAddGroup.lift_mk' (sesRelations (A := A)) _ _) (toK0_of F X))

end Functoriality

section UniversalProperty

variable {G : Type*} [AddCommGroup G]

-- Reference: C. A. Weibel, *The K-book*, Ch. II (additive invariants and the
-- universal property of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- An **additive invariant** of `A` with values in an abelian group `G`: a
function on objects that is constant on isomorphism classes and sends every
short exact sequence `0 → X₁ → X₂ → X₃ → 0` to `f X₂ = f X₁ + f X₃`. -/
structure AdditiveInvariant (A : Type u) [Category.{v} A] [Abelian A] (G : Type*)
    [AddCommGroup G] where
  /-- the underlying function on objects -/
  toFun : A → G
  /-- invariance under isomorphism -/
  iso : ∀ X Y : A, IsIsomorphic X Y → toFun X = toFun Y
  /-- additivity on short exact sequences -/
  ses : ∀ s : ShortExactSequence A, toFun s.sc.X₂ = toFun s.sc.X₁ + toFun s.sc.X₃

-- Reference: C. A. Weibel, *The K-book*, Ch. II (descent to isomorphism classes).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- An additive invariant descends to the isomorphism classes of objects. -/
def AdditiveInvariant.toIsoClasses (M : AdditiveInvariant A G) :
    Quotient (isIsomorphicSetoid A) → G :=
  Quotient.lift M.toFun (fun X Y h => M.iso X Y h)

-- Reference: C. A. Weibel, *The K-book*, Ch. II (descent to isomorphism classes).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The descended invariant takes the value of the invariant on a class. -/
theorem AdditiveInvariant.toIsoClasses_mk (M : AdditiveInvariant A G) (X : A) :
    M.toIsoClasses (⟦X⟧ : Quotient (isIsomorphicSetoid A)) = M.toFun X :=
  Quotient.lift_mk (s := isIsomorphicSetoid A) M.toFun (fun X Y h => M.iso X Y h) X

-- Reference: C. A. Weibel, *The K-book*, Ch. II (universal property of the
-- free abelian group).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The homomorphism from the free abelian group on isomorphism classes
induced by an additive invariant. -/
def AdditiveInvariant.toFreeAbelian (M : AdditiveInvariant A G) :
    FreeAbelianGroup (Quotient (isIsomorphicSetoid A)) →+ G :=
  FreeAbelianGroup.lift M.toIsoClasses

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the relations are killed).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The free-abelian homomorphism of an additive invariant kills every short
exact sequence relation. -/
theorem AdditiveInvariant.toFreeAbelian_sesRel (M : AdditiveInvariant A G)
    (ses : ShortExactSequence A) : M.toFreeAbelian (sesRel ses) = 0 := by
  have hzero : M.toFun ses.sc.X₂ - M.toFun ses.sc.X₁ - M.toFun ses.sc.X₃ = 0 :=
    Eq.trans
      (congrArg (fun t => t - M.toFun ses.sc.X₁ - M.toFun ses.sc.X₃) (M.ses ses))
      (Eq.trans (congrArg (fun t => t - M.toFun ses.sc.X₃) (add_sub_cancel_left _ _))
        (sub_self _))
  have h2 : M.toFreeAbelian (FreeAbelianGroup.of (⟦ses.sc.X₂⟧ :
        Quotient (isIsomorphicSetoid A))) = M.toFun ses.sc.X₂ :=
    Eq.trans (FreeAbelianGroup.lift_apply_of M.toIsoClasses _)
      (M.toIsoClasses_mk ses.sc.X₂)
  have h3 : M.toFreeAbelian (FreeAbelianGroup.of (⟦ses.sc.X₁⟧ :
        Quotient (isIsomorphicSetoid A))) = M.toFun ses.sc.X₁ :=
    Eq.trans (FreeAbelianGroup.lift_apply_of M.toIsoClasses _)
      (M.toIsoClasses_mk ses.sc.X₁)
  have h4 : M.toFreeAbelian (FreeAbelianGroup.of (⟦ses.sc.X₃⟧ :
        Quotient (isIsomorphicSetoid A))) = M.toFun ses.sc.X₃ :=
    Eq.trans (FreeAbelianGroup.lift_apply_of M.toIsoClasses _)
      (M.toIsoClasses_mk ses.sc.X₃)
  exact Eq.trans (map_sub M.toFreeAbelian _ _)
    (Eq.trans
      (congrArg (fun t => t - M.toFreeAbelian (FreeAbelianGroup.of (⟦ses.sc.X₃⟧ :
          Quotient (isIsomorphicSetoid A)))) (map_sub M.toFreeAbelian _ _))
      (Eq.trans
        (congrArg (fun t => (t - M.toFreeAbelian (FreeAbelianGroup.of (⟦ses.sc.X₁⟧ :
            Quotient (isIsomorphicSetoid A)))) - M.toFreeAbelian (FreeAbelianGroup.of
            (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A)))) h2)
        (Eq.trans
          (congrArg (fun t => (M.toFun ses.sc.X₂ - t) - M.toFreeAbelian (FreeAbelianGroup.of
              (⟦ses.sc.X₃⟧ : Quotient (isIsomorphicSetoid A)))) h3)
          (Eq.trans
            (congrArg (fun t => (M.toFun ses.sc.X₂ - M.toFun ses.sc.X₁) - t) h4) hzero))))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the universal property of K₀).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The **extension** of an additive invariant to a homomorphism `K0 A →+ G`. -/
def AdditiveInvariant.lift (M : AdditiveInvariant A G) : K0 A →+ G :=
  QuotientAddGroup.lift (sesRelations (A := A)) M.toFreeAbelian
    ((AddSubgroup.closure_le _).mpr (fun x hx => by
      obtain ⟨ses, rfl⟩ := hx
      exact AddMonoidHom.mem_ker.mpr (M.toFreeAbelian_sesRel ses)))

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the extension is compatible
-- with the class map).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The extension of an additive invariant is compatible with the class map:
`M.lift (of X) = M.toFun X`. -/
theorem AdditiveInvariant.lift_of (M : AdditiveInvariant A G) (X : A) :
    M.lift (of X) = M.toFun X :=
  Eq.trans (congrArg M.lift (QuotientAddGroup.mk'_apply (sesRelations (A := A)) _))
    (Eq.trans (QuotientAddGroup.lift_mk' (sesRelations (A := A)) _ _)
      (Eq.trans (FreeAbelianGroup.lift_apply_of M.toIsoClasses _) (M.toIsoClasses_mk X)))

-- Reference: standard freeness argument: a homomorphism out of a free abelian
-- group is determined by its values on the generators.
/-- Two homomorphisms out of a free abelian group that agree on all generators
`FreeAbelianGroup.of q` are equal. -/
theorem hom_ext_freeAbelian {α : Type*} {H : Type*} [AddCommGroup H]
    (φ ψ : FreeAbelianGroup α →+ H)
    (h : ∀ q : α, φ (FreeAbelianGroup.of q) = ψ (FreeAbelianGroup.of q)) : φ = ψ := by
  refine AddMonoidHom.ext (fun a => ?_)
  induction a using FreeAbelianGroup.induction_on with
  | zero => exact Eq.trans (map_zero φ) (Eq.symm (map_zero ψ))
  | of q => exact h q
  | neg x hx =>
      exact Eq.trans (map_neg φ _)
        (Eq.trans (congrArg Neg.neg hx) (map_neg ψ _).symm)
  | add x y hx hy =>
      exact Eq.trans (map_add φ _ _)
        (Eq.trans (congrArg₂ (· + ·) hx hy) (map_add ψ _ _).symm)

-- Reference: C. A. Weibel, *The K-book*, Ch. II (a homomorphism out of K₀ is
-- an additive invariant).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The **additive invariant** induced by a homomorphism `φ : K0 A →+ G`: the
function `X ↦ φ (of X)` on objects. -/
def AdditiveInvariant.ofHom (G : Type*) [AddCommGroup G] (φ : K0 A →+ G) :
    AdditiveInvariant A G where
  toFun := fun X => φ (of X)
  iso := fun X Y h => congrArg φ (of_eq_of_iso (X := X) (Y := Y) h)
  ses := fun s => Eq.trans (congrArg φ (of_shortExact s)) (map_add φ _ _)

-- Reference: C. A. Weibel, *The K-book*, Ch. II (the universal property of K₀
-- as a bijection between homomorphisms out of K₀ and additive invariants).
-- REVIEW(citation): pin the exact section within Ch. II (routed to W5, #13).
/-- The **universal property** of `K0 A`: homomorphisms `K0 A →+ G` are in
bijection with functions `A → G` that are constant on isomorphism classes and
additive on short exact sequences. -/
def liftEquiv (G : Type*) [AddCommGroup G] :
    (K0 A →+ G) ≃ {f : A → G // (∀ X Y : A, IsIsomorphic X Y → f X = f Y) ∧
      ∀ s : ShortExactSequence A, f s.sc.X₂ = f s.sc.X₁ + f s.sc.X₃} where
  toFun f := ⟨fun X => f (of X), ⟨fun X Y h => congrArg f (of_eq_of_iso (X := X) (Y := Y) h),
    fun s => Eq.trans (congrArg f (of_shortExact s)) (map_add f _ _)⟩⟩
  invFun p := (⟨p.1, p.2.1, p.2.2⟩ : AdditiveInvariant A G).lift
  left_inv f := QuotientAddGroup.addMonoidHom_ext (sesRelations (A := A))
    ((hom_ext_freeAbelian
      (φ := f.comp (QuotientAddGroup.mk' (sesRelations (A := A))))
      (ψ := ((AdditiveInvariant.ofHom G f).lift).comp
        (QuotientAddGroup.mk' (sesRelations (A := A)))))
      (fun q => by
        refine Quotient.inductionOn q (fun X => ?_)
        exact (AdditiveInvariant.lift_of (AdditiveInvariant.ofHom G f) X).symm)).symm
  right_inv p := Subtype.ext (funext (fun X =>
    AdditiveInvariant.lift_of (⟨p.1, p.2.1, p.2.2⟩ : AdditiveInvariant A G) X))

end UniversalProperty

end K0

end CategoryTheory
