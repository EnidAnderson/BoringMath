import Mathlib.CategoryTheory.Sites.MayerVietorisSquare

/-!
# cd-structures

This file introduces Voevodsky's **cd-structures**: a set of distinguished
commutative squares on a category, together with the Grothendieck topology
generated by such a set. It is the category-level half of the Nisnevich
program; the schemes-level half (`IsNisnevichSquare`, `nisnevichTopology`)
comes later, built on the étale and open-immersion API.

The bridge to the existing Mathlib layer is
`GrothendieckTopology.MayerVietorisSquare` (Riou), whose docstring names
the Nisnevich distinguished squares on schemes as the motivating example.

This module is a candidate extension to the Mathlib sites layer (see
`docs/STYLE.md`): all declarations are final in name and statement, every
proof is a direct term (no tactics; linear — each input used exactly once),
and each proof's load-bearing named lemma is recorded inline.

## References
* V. Voevodsky, *cd-structures*, unpublished notes (2010).
* C. Mazza, V. Voevodsky, C. Weibel, *Lecture Notes on Motivic Cohomology*,
  Clay Mathematics Monographs 2 (2006), the Nisnevich topology.
* J. Riou, `Mathlib.CategoryTheory.Sites.MayerVietorisSquare`.
-/

universe v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C]

-- Reference: V. Voevodsky, *cd-structures*, unpublished notes (2010), §1
-- (distinguished squares).
-- REVIEW(citation): pin down the exact definition and section in review.
/-- A **cd-structure** on a category `C` is a set of distinguished
commutative squares.

The Grothendieck topology generated by a cd-structure
(`GrothendieckTopology.ofCdStructure`) is determined by the requirement
that the two lower legs of every distinguished square cover its lower right
corner. -/
structure CdStructure (C : Type u) [Category.{v} C] where
  /-- The set of distinguished squares. -/
  squares : Set (Square C)

namespace CdStructure

-- Reference: J. Riou, `Mathlib.CategoryTheory.Sites.MayerVietorisSquare`
-- (the docstring names Nisnevich distinguished squares as the motivating
-- example).
/-- A cd-structure `D` is a **Mayer-Vietoris cd-structure** with respect
to a Grothendieck topology `J` if every distinguished square is a
Mayer-Vietoris square for `J`. -/
def IsMayerVietoris (D : CdStructure C) (J : GrothendieckTopology C)
    [HasWeakSheafify J (Type v)] : Prop :=
  ∀ ⦃sq : Square C⦄, sq ∈ D.squares →
    ∃ S : GrothendieckTopology.MayerVietorisSquare J, S.toSquare = sq

-- Reference: J. Riou, `MayerVietorisSquare.sheafCondition_of_sheaf` (the
-- sheaf condition is satisfied by sheaves).
/-- Let `D` be a Mayer-Vietoris cd-structure with respect to `J`. Every
`J`-sheaf of types satisfies the Mayer-Vietoris sheaf condition on every
distinguished square. -/
theorem exists_mayerVietorisSquare_and_sheafCondition
    (D : CdStructure C) {J : GrothendieckTopology C} [HasWeakSheafify J (Type v)]
    (hD : D.IsMayerVietoris J) (F : Sheaf J (Type v)) {sq : Square C}
    (hsq : sq ∈ D.squares) :
    ∃ S : GrothendieckTopology.MayerVietorisSquare J,
      S.toSquare = sq ∧ S.SheafCondition F.obj := by
  obtain ⟨S, hS⟩ := hD hsq
  exact ⟨S, hS, S.sheafCondition_of_sheaf F⟩

end CdStructure

namespace GrothendieckTopology

-- Reference: V. Voevodsky, *cd-structures*, unpublished notes (2010), §2
-- (the topology generated by a cd-structure).
-- REVIEW(citation): pin down the exact section in review.
/-- The Grothendieck topology generated by a cd-structure `D`: the
smallest Grothendieck topology on `C` in which the sieve of two arrows of
every distinguished square covers the lower right corner of the square. -/
def ofCdStructure (D : CdStructure C) : GrothendieckTopology C :=
  -- The smallest topology in which every distinguished square's two-arrow
  -- sieve covers: the infimum (in the complete lattice of topologies,
  -- `Mathlib/CategoryTheory/Sites/Grothendieck.lean:305`) of all
  -- topologies with that property. This is the honest instantiation of
  -- Voevodsky's generated topology. (The `Coverage`-route construction
  -- would require a pullback-stability input a general cd-structure does
  -- not carry; the two routes agree on saturated coverages by
  -- `Coverage.toGrothendieck_eq_sInf`, `Sites/Coverage.lean:299`.)
  sInf {J : GrothendieckTopology C |
    ∀ ⦃sq : Square C⦄, sq ∈ D.squares → Sieve.ofTwoArrows sq.f₂₄ sq.f₃₄ ∈ J sq.X₄}

-- Reference: V. Voevodsky, *cd-structures*, unpublished notes (2010), §2.
-- REVIEW(citation): pin down the exact section in review.
/-- The sieve of two arrows of a distinguished square is covering for the
Grothendieck topology generated by the cd-structure. -/
theorem sieve_ofTwoArrows_mem_of_mem_squares (D : CdStructure C) {sq : Square C}
    (hsq : sq ∈ D.squares) :
    Sieve.ofTwoArrows sq.f₂₄ sq.f₃₄ ∈ (ofCdStructure D) sq.X₄ :=
  -- Direct term: membership in the infimum is membership in every
  -- topology of the defining set (`GrothendieckTopology.mem_sInf`,
  -- `Mathlib/CategoryTheory/Sites/Grothendieck.lean:291`), and every
  -- topology of the set contains the two-arrow sieve by the set's own
  -- definition. Linear: each input is used exactly once.
  (mem_sInf _ _).mpr fun _ hJ => hJ hsq

-- Reference: V. Voevodsky, *cd-structures*, unpublished notes (2010), §2.
-- REVIEW(citation): pin down the exact section in review.
/-- The Grothendieck topology generated by a cd-structure is minimal:
every sieve covering for it covers for any Grothendieck topology in which
the two-arrow sieve of every distinguished square covers. -/
theorem mem_ofCdStructure_of_forall_mem_squares (D : CdStructure C)
    (J' : GrothendieckTopology C)
    (h : ∀ ⦃sq : Square C⦄, sq ∈ D.squares →
      Sieve.ofTwoArrows sq.f₂₄ sq.f₃₄ ∈ J' sq.X₄)
    {X : C} {S : Sieve X} (hS : S ∈ (ofCdStructure D) X) : S ∈ J' X :=
  -- Direct term: membership in the infimum gives membership in every
  -- topology of the defining set (`GrothendieckTopology.mem_sInf`,
  -- `Mathlib/CategoryTheory/Sites/Grothendieck.lean:291`), and `J'`
  -- belongs to the defining set by `h`. Linear: each input is used
  -- exactly once.
  (mem_sInf _ _).mp hS J' h

end GrothendieckTopology

end CategoryTheory
