import BoringMath.CategoryTheory.Sites.CdStructure
import Mathlib.AlgebraicGeometry.Restrict
import Mathlib.AlgebraicGeometry.Sites.BigZariski
import Mathlib.CategoryTheory.Sites.SheafCohomology.MayerVietoris
import Mathlib.Topology.Sheaves.MayerVietoris

/-!
# Binary Zariski open covers are Mayer–Vietoris squares

For a scheme `X` and opens `U V : X.Opens` with `U ⊔ V = ⊤`, the commutative
square `U ×[X] V ⟶ U`, `U ×[X] V ⟶ V`, `U ⟶ X`, `V ⟶ X` is the
distinguished square of the Zariski cd-structure. This module packages that
square as data in `Scheme` (clause (i)), proves that its two-arrow sieve is
covering for `Scheme.zariskiTopology`, and proves that on the small Zariski
site `X.Opens` the Zariski cd-structure is Mayer–Vietoris in the sense of
`CategoryTheory.CdStructure.IsMayerVietoris` (B.1, landed), whence every
sheaf of types satisfies Riou's Mayer–Vietoris sheaf condition
(`MayerVietorisSquare.sheafCondition_of_sheaf`) on every binary open-cover
square, and every abelian sheaf gets the Mayer–Vietoris long exact sequence
(`MayerVietorisSquare.sequence_exact`).

Site note (universe obstruction at the pin): the structure
`GrothendieckTopology.MayerVietorisSquare` requires
`HasWeakSheafify J (Type v)` with `v` the morphism universe of the site. On
`Scheme.{u}` (morphisms in `Type u`) only `Type (u + 1)`-sheafification
synthesizes at pin v4.35.0-rc3, so the `MayerVietorisSquare` structure is
formed on the `u`-small site `X.Opens` with
`_root_.Opens.grothendieckTopology X`; the big-site content is the
square-as-data and the covering-sieve lemma below.

## References
* J. Riou, `Mathlib.CategoryTheory.Sites.MayerVietorisSquare.lean` and
  `Mathlib.Topology.Sheaves.MayerVietoris.lean` (in-tree, read in full at
  the pin).
* J. Riou, `Mathlib.CategoryTheory.Sites.SheafCohomology.MayerVietoris.lean`
  (the long exact sequence, in-tree at the pin).
* Stacks Project, tag 08GL: elementary distinguished squares and
  Mayer–Vietoris squares (Cohomology of Algebraic Spaces, §75.9,
  Definition 75.9.1).
* R. Hartshorne, *Algebraic Geometry*, Springer GTM 52, 1977, Chapter II,
  §1 (sheaves on a topological space; the gluing axiom, p. 61).
* V. Voevodsky, *cd-structures*, unpublished notes (2010), §1 — the Zariski
  cd-structure as the trivial case of the Nisnevich one.
-/

universe u w

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

/-! ### Clause (i): the square of a binary open cover, as data in `Scheme` -/

-- Reference: R. Hartshorne, *Algebraic Geometry*, Springer GTM 52, 1977,
-- Chapter II, §1 (open covers of a scheme; the Zariski topology, p. 61);
-- in-tree anchor: J. Riou, `Mathlib.Topology.Sheaves.MayerVietoris`
-- (`Opens.mayerVietorisSquare`, the same square for opens of a space).
/-- The commutative square of a binary open cover of a scheme `X` by
`U V : X.Opens`: the pullback `U ×[X] V` with its two projections and the
open immersions `U.ι`, `V.ι` into `X`. Noncomputable because
`Limits.pullback` in `Scheme` is `Classical.choice`-backed. -/
noncomputable def openCoverSquare (X : Scheme.{u}) (U V : X.Opens) :
    Square Scheme.{u} where
  f₁₂ := pullback.fst (f := U.ι) (g := V.ι)
  f₁₃ := pullback.snd (f := U.ι) (g := V.ι)
  f₂₄ := U.ι
  f₃₄ := V.ι
  fac := pullback.condition

-- Reference: in-tree anchors `Square.IsPullback.mk` and
-- `Limits.pullbackIsPullback`
-- (`Mathlib.CategoryTheory.Limits.Shapes.Pullback.Square`): a square built
-- from a pullback cone is a pullback square.
/-- The open-cover square is a pullback square: `U ×[X] V` is the fibre
product of `U.ι` and `V.ι` over `X`. -/
theorem openCoverSquare_isPullback (X : Scheme.{u}) (U V : X.Opens) :
    (openCoverSquare X U V).IsPullback :=
  Square.IsPullback.mk (openCoverSquare X U V) (pullbackIsPullback U.ι V.ι)

/-! ### The Zariski coverage of a binary open cover on the big site -/

-- Reference: R. Hartshorne, *Algebraic Geometry*, Springer GTM 52, 1977,
-- Chapter II, §1 (p. 61: the Zariski topology is generated by open covers);
-- in-tree anchors `AlgebraicGeometry.Scheme.Cover.mkOfCovers` and
-- `AlgebraicGeometry.Scheme.Cover.mem_grothendieckTopology`
-- (`Mathlib.AlgebraicGeometry.Cover.MorphismProperty`,
-- `Mathlib.AlgebraicGeometry.Sites.Pretopology`).
/-- The two-element open cover of `X` by `U` and `V`, as a cover in the
Zariski pretopology `precoverage IsOpenImmersion`, when `U ⊔ V = ⊤`. -/
def binaryOpenCover (X : Scheme.{u}) (U V : X.Opens) (hUV : U ⊔ V = ⊤) :
    Cover (precoverage IsOpenImmersion) X :=
  Cover.mkOfCovers WalkingPair
    (fun k => WalkingPair.casesOn k (U : Scheme.{u}) (V : Scheme.{u}))
    (fun k => WalkingPair.casesOn k U.ι V.ι)
    (fun x => by
      have htop : x ∈ (⊤ : X.Opens) := TopologicalSpace.Opens.mem_top x
      have hx : x ∈ U ⊔ V := by
        rw [hUV] -- hUV fully instantiated (U, V fixed); `U ⊔ V` occurs once in the goal
        exact htop
      obtain hx | hx := TopologicalSpace.Opens.mem_sup.mp hx
      · exact ⟨WalkingPair.left, ⟨x, hx⟩, Scheme.Opens.ι_apply U ⟨x, hx⟩⟩
      · exact ⟨WalkingPair.right, ⟨x, hx⟩, Scheme.Opens.ι_apply V ⟨x, hx⟩⟩)
    (fun k => WalkingPair.casesOn k
      (inferInstance : IsOpenImmersion U.ι) (inferInstance : IsOpenImmersion V.ι))

-- Reference: in-tree anchor `AlgebraicGeometry.Scheme.Cover.mem_grothendieckTopology`
-- (`Mathlib.AlgebraicGeometry.Sites.Pretopology`): the sieve of a pretopology
-- cover covers for the generated topology, and `Scheme.zariskiTopology` is
-- `grothendieckTopology IsOpenImmersion` (`Mathlib.AlgebraicGeometry.Sites.BigZariski`).
/-- For `U V : X.Opens` with `U ⊔ V = ⊤`, the sieve generated by the two open
immersions `U.ι` and `V.ι` is covering for the Zariski topology
`Scheme.zariskiTopology` on `Scheme.{u}`. -/
theorem sieve_ofTwoArrows_mem_zariskiTopology_of_sup_eq_top (X : Scheme.{u})
    {U V : X.Opens} (hUV : U ⊔ V = ⊤) :
    Sieve.ofTwoArrows U.ι V.ι ∈ zariskiTopology X :=
  (binaryOpenCover X U V hUV).mem_grothendieckTopology

/-! ### Clause (ii): the Zariski cd-structure on the small site is
Mayer–Vietoris -/

-- Reference: J. Riou, `Mathlib.Topology.Sheaves.MayerVietoris`
-- (`Opens.grothendieckTopology`, the Grothendieck topology on the poset of
-- opens generated by open covers).
/-- The small Zariski topology on `X.Opens`: the Grothendieck topology on the
poset of opens of `X` generated by open covers (the small Zariski site of
`X`). -/
abbrev smallZariskiTopology (X : Scheme.{u}) : GrothendieckTopology X.Opens :=
  _root_.Opens.grothendieckTopology X

-- Reference: J. Riou, `Mathlib.Topology.Sheaves.MayerVietoris` (the square
-- `U ⊓ V ⟶ U`, `U ⊓ V ⟶ V`, `U ⟶ U ⊔ V`, `V ⟶ U ⊔ V` in `Opens X`).
/-- The commutative square of two opens `U V : X.Opens` in the small Zariski
site `X.Opens`, with lower-right corner `U ⊔ V`. -/
def openCoverSquareOpens {X : Scheme.{u}} (U V : X.Opens) : Square X.Opens where
  X₁ := U ⊓ V
  X₂ := U
  X₃ := V
  X₄ := U ⊔ V
  f₁₂ := CategoryTheory.homOfLE inf_le_left
  f₁₃ := CategoryTheory.homOfLE inf_le_right
  f₂₄ := CategoryTheory.homOfLE le_sup_left
  f₃₄ := CategoryTheory.homOfLE le_sup_right
  fac := Subsingleton.elim _ _

-- Reference: J. Riou, `Mathlib.Topology.Sheaves.MayerVietoris`
-- (`Opens.mayerVietorisSquare'`), via
-- `GrothendieckTopology.MayerVietorisSquare.mk_of_isPullback`
-- (`Mathlib.CategoryTheory.Sites.MayerVietorisSquare`): a pullback square
-- whose two lower legs form a covering sieve is Mayer–Vietoris.
/-- For any two opens `U V : X.Opens`, the open-cover square in `X.Opens` is
a Mayer–Vietoris square for the small Zariski topology. -/
theorem exists_mayerVietorisSquare_of_openCover {X : Scheme.{u}} (U V : X.Opens) :
    ∃ S : (smallZariskiTopology X).MayerVietorisSquare,
      S.toSquare = openCoverSquareOpens U V :=
  ⟨_root_.Opens.mayerVietorisSquare' (openCoverSquareOpens U V) rfl rfl,
    _root_.Opens.mayerVietorisSquare'_toSquare _ _ _⟩

-- Reference: V. Voevodsky, *cd-structures*, unpublished notes (2010), §1
-- (distinguished squares; the Zariski cd-structure: binary open covers).
-- REVIEW(citation): pin down the exact section in review.
/-- The Zariski cd-structure on the small Zariski site `X.Opens`: the
distinguished squares are the open-cover squares `openCoverSquareOpens U V`
with `U ⊔ V = ⊤`. -/
def zariskiCdStructure (X : Scheme.{u}) : CdStructure X.Opens where
  squares := {sq | ∃ (U V : X.Opens), U ⊔ V = ⊤ ∧ openCoverSquareOpens U V = sq}

-- Reference: J. Riou, `Mathlib.Topology.Sheaves.MayerVietoris`
-- (`Opens.mayerVietorisSquare'`), packaged via
-- `CategoryTheory.CdStructure.IsMayerVietoris` (B.1, landed).
/-- The Zariski cd-structure on the small Zariski site of a scheme is
Mayer–Vietoris with respect to the small Zariski topology: every binary
open-cover square with `U ⊔ V = ⊤` is a Mayer–Vietoris square. -/
theorem zariskiCdStructure_isMayerVietoris (X : Scheme.{u}) :
    (zariskiCdStructure X).IsMayerVietoris (smallZariskiTopology X) := by
  intro sq hsq
  obtain ⟨U, V, _, hsq⟩ := hsq
  exact ⟨_root_.Opens.mayerVietorisSquare' (openCoverSquareOpens U V) rfl rfl,
    (_root_.Opens.mayerVietorisSquare'_toSquare _ _ _).trans hsq⟩

-- Reference: B.1 (landed): `CategoryTheory.CdStructure
-- .exists_mayerVietorisSquare_and_sheafCondition`, which applies J. Riou's
-- `GrothendieckTopology.MayerVietorisSquare.sheafCondition_of_sheaf`
-- (`Mathlib.CategoryTheory.Sites.MayerVietorisSquare`).
/-- Bridge (B.1) applied to the Zariski cd-structure: every sheaf of types on
the small Zariski site satisfies the Mayer–Vietoris sheaf condition on every
binary open-cover square `U ⊔ V = ⊤`. -/
theorem exists_mayerVietorisSquare_and_sheafCondition_of_mem_zariskiCdStructure
    (X : Scheme.{u}) (F : Sheaf (smallZariskiTopology X) (Type u))
    {sq : Square X.Opens} (hsq : sq ∈ (zariskiCdStructure X).squares) :
    ∃ S : (smallZariskiTopology X).MayerVietorisSquare,
      S.toSquare = sq ∧ S.SheafCondition F.obj :=
  CdStructure.exists_mayerVietorisSquare_and_sheafCondition (zariskiCdStructure X)
    (zariskiCdStructure_isMayerVietoris X) F hsq

/-! ### Clause (iii): the Mayer–Vietoris long exact sequence, instantiated -/

-- Reference: J. Riou, `Mathlib.CategoryTheory.Sites.SheafCohomology
-- .MayerVietoris` (`MayerVietorisSquare.sequence_exact`): the
-- Mayer–Vietoris long exact sequence
-- `... ⟶ H^n(X₄) ⟶ H^n(X₂) ⊞ H^n(X₃) ⟶ H^n(X₁) ⟶ H^{n+1}(X₄) ⟶ ...`;
-- Stacks Project, tag 08GL.
-- REVIEW(citation): pin down the exact Hartshorne section (II.1/III.2) in review.
/-- The Mayer–Vietoris application: for a Mayer–Vietoris square `S` on the
small Zariski site of `X` (e.g. an open-cover square from
`exists_mayerVietorisSquare_of_openCover`) and an abelian sheaf `F`, the
Mayer–Vietoris sequence of `S` is exact. Zero new cohomological content:
this is the in-tree `sequence_exact` instantiated. -/
theorem mayerVietoris_sequence_exact {X : Scheme.{u}}
    (S : (smallZariskiTopology X).MayerVietorisSquare)
    (F : Sheaf (smallZariskiTopology X) AddCommGrpCat.{u}) (n₀ n₁ : ℕ) (h : n₀ + 1 = n₁)
    [HasExt.{w} (Sheaf (smallZariskiTopology X) AddCommGrpCat.{u})] :
    (S.sequence F n₀ n₁ h).Exact :=
  S.sequence_exact F n₀ n₁ h

end AlgebraicGeometry.Scheme
