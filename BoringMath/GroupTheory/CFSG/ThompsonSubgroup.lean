import Mathlib.GroupTheory.PGroup

/-!
# The Thompson subgroup `J(P)` — foundation of the CFSG local-analysis library

Ticket CFSG.LIB (#236), feeding CFSG.R.2 (#228). For a `p`-group `P`, the
**Thompson subgroup** `J(P)` is the subgroup generated by the maximal abelian
subgroups of `P`. It is characteristic in `P` and controls the Thompson
factorization. mathlib at the pin has no `J(P)`.

## References
* [GLS] Number 2 (Thompson subgroup, factorization theorem).
-/

namespace BoringMath

open Subgroup

variable {G : Type*} [Group G]

-- Reference: [GLS] Number 2, ch. 1 (`J(P)` generated by maximal abelian
-- subgroups).
/-- A subgroup `A` of `P` is **maximal abelian** if it is abelian and maximal
among abelian subgroups of `P`. -/
def IsMaximalAbelian (P A : Subgroup G) : Prop :=
  A ≤ P ∧ (∀ a ∈ A, ∀ b ∈ A, a * b = b * a) ∧
    ∀ B : Subgroup G, B ≤ P → (∀ a ∈ B, ∀ b ∈ B, a * b = b * a) → A ≤ B → B = A

-- Reference: [GLS] Number 2 (definition of the Thompson subgroup).
/-- The **Thompson subgroup** `J(P)`: the subgroup generated by the maximal
abelian subgroups of `P`. -/
def thompsonSubgroup (P : Subgroup G) : Subgroup G :=
  ⨆ (A : Subgroup G) (_ : IsMaximalAbelian P A), A

-- Reference: immediate from the definition (`iSup₂_le`); [GLS] Number 2
-- (`J(P) ≤ P`).
/-- **`J(P)` is contained in `P`** (proved). -/
theorem thompsonSubgroup_le (P : Subgroup G) : thompsonSubgroup P ≤ P :=
  iSup₂_le fun _ hA => hA.1

-- Reference: immediate from the definition (`le_iSup₂`); [GLS] Number 2.
/-- **Every maximal abelian subgroup lies in `J(P)`** (proved). -/
theorem le_thompsonSubgroup {P A : Subgroup G} (hA : IsMaximalAbelian P A) :
    A ≤ thompsonSubgroup P :=
  le_iSup₂ (f := fun (A' : Subgroup G) (_ : IsMaximalAbelian P A') => A') A hA

variable {G H : Type*} [Group G] [Group H]

-- Reference: immediate (a group isomorphism preserves subgroup order, abelianness,
-- and maximality); [GLS] Number 2.
/-- **Maximal abelian subgroups are preserved by a group isomorphism** (proved). -/
theorem IsMaximalAbelian.map {P A : Subgroup G} {φ : G ≃* H} (h : IsMaximalAbelian P A) :
    IsMaximalAbelian (P.map φ.toMonoidHom) (A.map φ.toMonoidHom) := by
  refine ⟨Subgroup.map_mono h.1, ?_, ?_⟩
  · intro a ha b hb
    obtain ⟨a', ha', rfl⟩ := Subgroup.mem_map.mp ha
    obtain ⟨b', hb', rfl⟩ := Subgroup.mem_map.mp hb
    exact (map_mul φ a' b').symm.trans
      ((congrArg φ (h.2.1 a' ha' b' hb')).trans (map_mul φ b' a'))
  · intro B hBP hBabel hAmap
    have hcomap_le : B.comap φ.toMonoidHom ≤ P :=
      Eq.subst (motive := fun K => B.comap φ.toMonoidHom ≤ K)
        (Subgroup.comap_map_eq_self_of_injective φ.injective P) (Subgroup.comap_mono hBP)
    have hcomap_abel : ∀ a ∈ B.comap φ.toMonoidHom, ∀ b ∈ B.comap φ.toMonoidHom,
        a * b = b * a := by
      intro a ha b hb
      have hab : φ a * φ b = φ b * φ a :=
        hBabel (φ a) (Subgroup.mem_comap.mp ha) (φ b) (Subgroup.mem_comap.mp hb)
      exact φ.injective ((map_mul φ a b).trans (hab.trans (map_mul φ b a).symm))
    have hA_le : A ≤ B.comap φ.toMonoidHom := (Subgroup.map_le_iff_le_comap).mp hAmap
    have h_eq : B.comap φ.toMonoidHom = A :=
      h.2.2 (B.comap φ.toMonoidHom) hcomap_le hcomap_abel hA_le
    exact (Subgroup.map_comap_eq_self_of_surjective φ.surjective B).symm.trans
      (congrArg (fun K => K.map φ.toMonoidHom) h_eq)

-- Reference: [GLS] Number 2 (`J(P)` is characteristic in `P`, hence invariant
-- under isomorphisms).
/-- **The Thompson subgroup is preserved by a group isomorphism** (proved). -/
theorem map_thompsonSubgroup (P : Subgroup G) (φ : G ≃* H) :
    (thompsonSubgroup P).map φ.toMonoidHom = thompsonSubgroup (P.map φ.toMonoidHom) := by
  apply le_antisymm
  · refine (Subgroup.map_le_iff_le_comap).mpr (iSup₂_le fun A hA => ?_)
    exact (Subgroup.map_le_iff_le_comap).mp
      (le_thompsonSubgroup (IsMaximalAbelian.map (φ := φ) hA))
  · refine iSup₂_le fun B hB => ?_
    have hcomap : IsMaximalAbelian P (B.comap φ.toMonoidHom) := by
      refine ⟨?_, ?_, ?_⟩
      · exact Eq.subst (motive := fun K => B.comap φ.toMonoidHom ≤ K)
          (Subgroup.comap_map_eq_self_of_injective φ.injective P)
          (Subgroup.comap_mono hB.1)
      · intro a ha b hb
        have hab : φ a * φ b = φ b * φ a :=
          hB.2.1 (φ a) (Subgroup.mem_comap.mp ha) (φ b) (Subgroup.mem_comap.mp hb)
        exact φ.injective ((map_mul φ a b).trans (hab.trans (map_mul φ b a).symm))
      · intro C hCP hCabel hBC
        have hCmap_abel : ∀ a ∈ C.map φ.toMonoidHom, ∀ b ∈ C.map φ.toMonoidHom,
            a * b = b * a := by
          intro a ha b hb
          obtain ⟨a', ha', rfl⟩ := Subgroup.mem_map.mp ha
          obtain ⟨b', hb', rfl⟩ := Subgroup.mem_map.mp hb
          exact (map_mul φ a' b').symm.trans
            ((congrArg φ (hCabel a' ha' b' hb')).trans (map_mul φ b' a'))
        have hB_le : B ≤ C.map φ.toMonoidHom :=
          Eq.subst (motive := fun K => K ≤ C.map φ.toMonoidHom)
            (Subgroup.map_comap_eq_self_of_surjective φ.surjective B)
            (Subgroup.map_mono hBC)
        have h_eq : C.map φ.toMonoidHom = B :=
          hB.2.2 (C.map φ.toMonoidHom) (Subgroup.map_mono hCP) hCmap_abel hB_le
        exact (Subgroup.comap_map_eq_self_of_injective φ.injective C).symm.trans
          (congrArg (fun K => K.comap φ.toMonoidHom) h_eq)
    exact Eq.subst (motive := fun K => K ≤ (thompsonSubgroup P).map φ.toMonoidHom)
      (Subgroup.map_comap_eq_self_of_surjective φ.surjective B)
      (Subgroup.map_mono (le_thompsonSubgroup hcomap))

end BoringMath
