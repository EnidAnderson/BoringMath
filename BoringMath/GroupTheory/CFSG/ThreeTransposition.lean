import Mathlib.GroupTheory.OrderOfElement

/-!
# 3-transposition groups — Fischer's class `D`

Ticket CFSG.LIB.threetransposition (#245). A group `G` with a distinguished
class `D` of involutions generating `G`, such that the product of any two
members of `D` has order at most `3`. Fischer's theorem classifies the finite
3-transposition groups (the sporadic Fischer groups and the classical ones).

## References
* [Fischer] B. Fischer, *Finite groups generated by 3-transpositions* (1971);
  [GLS] Number 3.
* mathlib pin v4.35.0-rc3: `orderOf_eq_prime`, `Subgroup.closure`.
-/

namespace BoringMath

variable {G : Type*} [Group G]

-- Reference: [Fischer] 1971 (definition of a class of 3-transpositions);
-- [GLS] Number 3, ch. on sporadic groups.
/-- A **3-transposition group**: a group `G` with a class `D` of involutions
generating `G`, with `orderOf (x * y) ≤ 3` for all `x, y ∈ D`. -/
structure ThreeTranspositionGroup (G : Type*) [Group G] where
  /-- The distinguished class of involutions. -/
  D : Set G
  /-- Every member of `D` is a nontrivial involution. -/
  invol : ∀ x ∈ D, x ≠ 1 ∧ x * x = 1
  /-- `D` generates `G`. -/
  gen : Subgroup.closure D = ⊤
  /-- Products of two members of `D` have order at most `3`. -/
  three : ∀ x ∈ D, ∀ y ∈ D, orderOf (x * y) ≤ 3

-- Reference: mathlib pin v4.35.0-rc3, `orderOf_eq_prime`; [Fischer] (members of
-- `D` are involutions).
/-- **Members of `D` have order exactly `2`** (proved). -/
theorem ThreeTranspositionGroup.orderOf_eq_two {G : Type*} [Group G]
    (T : ThreeTranspositionGroup G) {x : G} (hx : x ∈ T.D) : orderOf x = 2 :=
  @orderOf_eq_prime G _ x 2 ⟨Nat.prime_two⟩ ((pow_two x).trans (T.invol x hx).2)
    (T.invol x hx).1

end BoringMath
